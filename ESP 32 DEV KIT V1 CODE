// ---------------- SENSOR HELPERS --------------------
bool validLoadReading(long value) {
  return !(value >= 8380000L || value <= -8380000L);
}

void initLoadCell() {
  Serial.println("\nInitializing HX711...");
  scale.begin(HX_DOUT, HX_SCK);
  hxOK = scale.wait_ready_timeout(2000);
  Serial.println(hxOK ? "HX711: CONNECTED" : "HX711: ERROR");
}

void initAccelerometer() {
  Serial.println("\nInitializing ADXL345...");
  Wire.begin(ADXL_SDA, ADXL_SCL);
  adxlOK = adxl.begin();
  if (adxlOK) {
    adxl.setRange(ADXL345_RANGE_4_G);
    Serial.println("ADXL345: CONNECTED");
  } else Serial.println("ADXL345: ERROR");
}

void initMicrophone() {
  Serial.println("\nInitializing INMP441...");
  i2s_config_t config = {
    .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_RX),
    .sample_rate = SAMPLE_RATE,
    .bits_per_sample = I2S_BITS_PER_SAMPLE_32BIT,
    .channel_format = I2S_CHANNEL_FMT_ONLY_LEFT,
    .communication_format = I2S_COMM_FORMAT_I2S,
    .intr_alloc_flags = 0,
    .dma_buf_count = 4,
    .dma_buf_len = 256,
    .use_apll = false,
    .tx_desc_auto_clear = false,
    .fixed_mclk = 0
  };
  i2s_pin_config_t pins = {
    .bck_io_num = MIC_BCLK,
    .ws_io_num = MIC_WS,
    .data_out_num = -1,
    .data_in_num = MIC_SD
  };
  esp_err_t result = i2s_driver_install(I2S_PORT, &config, 0, NULL);
  if (result != ESP_OK) {
    micOK = false;
    Serial.printf("I2S installation error: %d\n", result);
    return;
  }
  result = i2s_set_pin(I2S_PORT, &pins);
  if (result != ESP_OK) {
    micOK = false;
    Serial.printf("I2S pin error: %d\n", result);
    i2s_driver_uninstall(I2S_PORT);
    return;
  }
  i2s_zero_dma_buffer(I2S_PORT);
  micOK = true;
  Serial.println("INMP441: INITIALIZED");
}

bool readLoadCell(long &value) {
  if (!hxOK || !scale.wait_ready_timeout(100)) return false;
  value = scale.read_average(3);
  return validLoadReading(value);
}

bool readAccelerometer() {
  if (!adxlOK) return false;
  const int samples = 20;
  double sumSquares = 0;
  for (int i = 0; i < samples; i++) {
    sensors_event_t event;
    adxl.getEvent(&event);
    ax = event.acceleration.x;
    ay = event.acceleration.y;
    az = event.acceleration.z;
    float magnitude = sqrtf(ax * ax + ay * ay + az * az);
    float dynamicAcceleration = magnitude - 9.80665f;
    sumSquares += dynamicAcceleration * dynamicAcceleration;
    delay(10);
  }
  vibrationRMS = sqrtf(sumSquares / samples);
  return isfinite(ax) && isfinite(ay) && isfinite(az) && isfinite(vibrationRMS);
}

bool readMicrophone(float &dbfs) {
  if (!micOK) return false;
  int32_t samples[SAMPLE_COUNT];
  size_t bytesRead = 0;
  esp_err_t result = i2s_read(I2S_PORT, samples, sizeof(samples), &bytesRead, pdMS_TO_TICKS(150));
  int count = bytesRead / sizeof(int32_t);
  if (result != ESP_OK || count == 0) return false;
  double sum = 0, sumSquares = 0;
  for (int i = 0; i < count; i++) {
    int32_t sample = samples[i] >> 8;
    sum += sample;
    sumSquares += (double)sample * sample;
  }
  double mean = sum / count;
  double variance = sumSquares / count - mean * mean;
  if (variance < 0) variance = 0;
  double rms = sqrt(variance);
  dbfs = (rms <= 0) ? -120.0f : 20.0f * log10(rms / 8388607.0);
  return isfinite(dbfs);
}

void calibrateBaselines() {
  Serial.println("\nKeep load platform unloaded and sensors still for calibration.");
  if (hxOK) {
    long total = 0; int valid = 0;
    for (int i = 0; i < 20; i++) {
      long value;
      if (readLoadCell(value)) { total += value; valid++; }
      delay(100);
    }
    if (valid >= 15) {
      loadBaseline = total / valid; loadBaselineOK = true;
      Serial.printf("Load baseline: %ld counts\n", loadBaseline);
    } else Serial.println("Load baseline unavailable.");
  }
  if (adxlOK) {
    double total = 0; int valid = 0;
    for (int i = 0; i < 10; i++) {
      if (readAccelerometer()) { total += vibrationRMS; valid++; }
      delay(100);
    }
    if (valid >= 8) {
      vibrationBaseline = total / valid; accelBaselineOK = true;
      Serial.printf("Vibration baseline: %.3f m/s^2\n", vibrationBaseline);
    } else Serial.println("Vibration baseline unavailable.");
  }
  if (micOK) {
    double total = 0; int valid = 0;
    for (int i = 0; i < 20; i++) {
      float value;
      if (readMicrophone(value)) { total += value; valid++; }
      delay(100);
    }
    if (valid >= 15) {
      soundBaseline = total / valid; micBaselineOK = true;
      Serial.printf("Sound baseline: %.2f dBFS\n", soundBaseline);
    } else Serial.println("Sound baseline unavailable.");
  }
}

void detectLoad() {
  long value;
  if (!readLoadCell(value)) {
    currentLoadValid = false; loadCount = 0; return;
  }
  currentLoad = value; currentLoadValid = true;
  if (!loadBaselineOK) { loadCount = 0; return; }
  loadDifference = currentLoad - loadBaseline;
  if (labs(loadDifference) >= LOAD_THRESHOLD) {
    loadCount++; loadClearCount = 0;
    if (loadCount >= REQUIRED_READINGS) loadAlert = true;
  } else {
    loadCount = 0;
    if (loadAlert && ++loadClearCount >= 3) {
      loadAlert = false; loadClearCount = 0;
    }
  }
}

void detectVibration() {
  if (!accelBaselineOK || !readAccelerometer()) {
    vibrationCount = 0; return;
  }
  vibrationChange = vibrationRMS - vibrationBaseline;
  if (vibrationChange >= VIBRATION_THRESHOLD) {
    vibrationCount++;
    if (vibrationCount >= REQUIRED_READINGS) vibrationAlert = true;
    vibrationClearCount = 0;
  } else {
    vibrationCount = 0;
    if (vibrationAlert && ++vibrationClearCount >= 3) {
      vibrationAlert = false; vibrationClearCount = 0;
    }
  }
}

void detectSound() {
  float value;
  if (!micBaselineOK || !readMicrophone(value)) {
    soundCount = 0; return;
  }
  currentSound = value;
  soundIncrease = currentSound - soundBaseline;
  bool increased = soundIncrease >= SOUND_THRESHOLD_DB && currentSound >= MIN_SOUND_DBFS;
  if (increased) {
    soundCount++;
    if (soundCount >= REQUIRED_READINGS) {
      soundAlert = true; soundLastDetected = millis();
    }
  } else {
    soundCount = 0;
    if (soundAlert && millis() - soundLastDetected >= 2000) soundAlert = false;
  }
}

void updateDemoLoad() {
  if (millis() - lastDemoUpdate < 1000) return;
  lastDemoUpdate = millis();
  if (vibrationAlert || (accelBaselineOK && vibrationChange >= VIBRATION_THRESHOLD))
    demoLoadKg = random(350, 501) / 10.0f;
  else demoLoadKg = random(0, 350) / 10.0f;
}

// ---------------- CII CALCULATION --------------------
float clamp100(float x) {
  if (!isfinite(x) || x < 0) return 0;
  if (x > 100) return 100;
  return x;
}

void updateCII() {
  if (millis() - lastCiiUpdate < 1000) return;
  lastCiiUpdate = millis();

  // Normalized input components, each in range 0..100.
  P = (currentLoadValid && loadBaselineOK)
      ? clamp100((float)labs(loadDifference) * 100.0f / (float)LOAD_THRESHOLD) : 0;
  V = (accelBaselineOK)
      ? clamp100(fmaxf(0, vibrationChange) * 100.0f / VIBRATION_THRESHOLD) : 0;
  S = (micBaselineOK)
      ? clamp100(fmaxf(0, soundIncrease) * 100.0f / SOUND_THRESHOLD_DB) : 0;

  if (!ciiInitialized) {
    previousP = P; previousV = V; ciiInitialized = true;
  }
  dP = clamp100(fabsf(P - previousP));
  dV = clamp100(fabsf(V - previousV));
  previousP = P; previousV = V;

  CII = clamp100(0.35f * P + 0.25f * V + 0.20f * S + 0.10f * dP + 0.10f * dV);
}

// ---------------- WIFI + WEB SERVER -----------------
void setupWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
  Serial.print("\nConnecting to Wi-Fi");
  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < 20000) {
    delay(500); Serial.print(".");
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\nWi-Fi connected!");
    Serial.print("Open dashboard at: http://");
    Serial.println(WiFi.localIP());
  } else {
    Serial.println("\nWi-Fi connection failed. Check SSID/password and 2.4 GHz Wi-Fi.");
  }
}

String jsonNumber(float value, int decimals = 2) {
  if (!isfinite(value)) return "null";
  return String(value, decimals);
}

void handleApi() {
  String json = "{";
  json += "\"wifi\":\"" + String(WiFi.status() == WL_CONNECTED ? "CONNECTED" : "DISCONNECTED") + "\",";
  json += "\"time\":\"" + String(millis() / 1000) + " s\",";
  json += "\"cii\":" + jsonNumber(CII, 2) + ",";
  json += "\"p\":" + jsonNumber(P, 2) + ",";
  json += "\"v\":" + jsonNumber(V, 2) + ",";
  json += "\"s\":" + jsonNumber(S, 2) + ",";
  json += "\"dp\":" + jsonNumber(dP, 2) + ",";
  json += "\"dv\":" + jsonNumber(dV, 2) + ",";
  json += "\"raw\":\"" + String(currentLoadValid ? String(currentLoad) : "N/A") + "\",";
  json += "\"kg\":" + jsonNumber(demoLoadKg, 1) + ",";
  json += "\"ax\":" + jsonNumber(adxlOK ? ax : NAN, 2) + ",";
  json += "\"ay\":" + jsonNumber(adxlOK ? ay : NAN, 2) + ",";
  json += "\"az\":" + jsonNumber(adxlOK ? az : NAN, 2) + ",";
  json += "\"vibration\":" + jsonNumber(accelBaselineOK ? vibrationChange : NAN, 3) + ",";
  json += "\"sound\":" + jsonNumber(micBaselineOK ? currentSound : NAN, 1) + ",";
  json += "\"alert\":\"" + String((loadAlert || vibrationAlert || soundAlert) ? "HIGH" : "NORMAL") + "\"";
  json += "}";
  server.send(200, "application/json", json);
}

void setupWebServer() {
  server.on("/", HTTP_GET, []() {
    server.send_P(200, "text/html", DASHBOARD_HTML);
  });
  server.on("/api/data", HTTP_GET, handleApi);
  server.begin();
  Serial.println("Web server started on port 80.");
}

// ---------------- SETUP / LOOP -----------------------
void setup() {
  Serial.begin(115200);
  delay(1500);
  randomSeed(esp_random());

  Serial.println("\n========================================");
  Serial.println(" STAMPEDE DETECTOR - ESP32 NODE 1");
  Serial.println(" Wi-Fi Dashboard + CII");
  Serial.println("========================================");

  initLoadCell();
  initAccelerometer();
  initMicrophone();
  calibrateBaselines();

  setupWiFi();
  if (WiFi.status() == WL_CONNECTED) setupWebServer();

  Serial.println("\nMonitoring started.");
}

void loop() {
  detectLoad();
  detectVibration();
  detectSound();
  updateDemoLoad();
  updateCII();

  if (WiFi.status() == WL_CONNECTED) {
    server.handleClient();
  }

  if (millis() - lastDisplay >= 1000) {
    lastDisplay = millis();
    Serial.printf("CII=%.1f | P=%.1f V=%.1f S=%.1f dP=%.1f dV=%.1f | Alert=%s\n",
      CII, P, V, S, dP, dV,
      (loadAlert || vibrationAlert || soundAlert) ? "HIGH" : "NORMAL");
  }
  delay(20);
}
